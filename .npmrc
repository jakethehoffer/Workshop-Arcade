# Resolve all packages from the public npm registry.
#
# Dependabot auto-injects a GitHub Packages credential (npm.pkg.github.com) for
# this repo. Without an .npmrc its npm updater aborts file fetching with
# "Private npm registries require either a .npmrc file in your repository, or
# explicit scope/replaces-base configuration in dependabot.yml. Registry:
# npm.pkg.github.com" — which is why the playwright-bump refresh job failed.
#
# This project uses only public packages (Playwright), so pinning the default
# registry here gives Dependabot the .npmrc it requires, keeps `npm ci`
# deterministic on public npm, and needs no auth token.
registry=https://registry.npmjs.org/
