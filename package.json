{
  "name": "workshop-arcade",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Static browser game catalog validation and smoke tests.",
  "scripts": {
    "start": "node scripts/serve-static.mjs",
    "setup": "npx playwright install chromium",
    "test": "node scripts/run-fast-tests.mjs",
    "test:all": "node scripts/run-fast-tests.mjs && npm run test:games",
    "capture:games": "node scripts/capture-games.mjs",
    "capture:games:ci": "node scripts/capture-games.mjs --ci",
    "test:docs": "node scripts/check-docs-drift.mjs",
    "test:tools": "node scripts/check-tools.mjs",
    "test:capture-recipes": "node scripts/capture-games.mjs --check-recipes",
    "test:games": "node scripts/smoke-games.mjs",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "test:a11y-polish": "node scripts/check-a11y-polish.mjs",
    "test:pwa": "node scripts/check-pwa.mjs",
    "test:random-game": "node scripts/check-random-game.mjs",
    "test:contributor-onboarding": "node scripts/check-contributor-onboarding.mjs",
    "test:security-workflows": "node scripts/check-security-workflows.mjs",
    "test:sw-update-toast": "node scripts/check-sw-update-toast.mjs",
    "test:test-aggregator": "node scripts/check-test-aggregator.mjs",
    "audit:perf": "node scripts/audit-pagespeed.mjs",
    "audit:perf:ci": "node scripts/audit-pagespeed.mjs --ci",
    "build:feed": "node scripts/build-feed.mjs",
    "build:og-images": "node scripts/build-og-images.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "inject:meta": "node scripts/inject-game-meta.mjs",
    "test:catalog-perf": "node scripts/check-catalog-perf.mjs",
    "test:deep-links": "node scripts/check-deep-links.mjs",
    "test:fallback-pages": "node scripts/check-fallback-pages.mjs",
    "test:feed": "node scripts/check-feed.mjs",
    "test:keyboard-help": "node scripts/check-keyboard-help.mjs",
    "test:manifest-schema": "node scripts/check-manifest-schema.mjs",
    "test:meta-files": "node scripts/check-meta-files.mjs",
    "test:og-images": "node scripts/check-og-images.mjs",
    "test:game-jsonld": "node scripts/check-game-jsonld.mjs",
    "test:seo": "node scripts/check-seo.mjs"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
